html:has(> body.theme-notebook) {
  background: #e8dcc8;
}
body.theme-notebook {
  font-family: "LXGW WenKai TC", "Noto Sans TC", sans-serif;
  color: #3b3027;
  background-color: #fffaf0;
  background-image: linear-gradient(#e7eef9 1px, transparent 1px);
  background-size: 100% 32px;
  border-radius: 6px;
  box-shadow: 0 2px 0 #d5c4a8, 0 20px 40px -18px rgba(70, 50, 20, .5);
  border-left: 10px solid #f2a7a0;
}
.theme-notebook h1 { color: #c2412d; font-weight: 400; transform: rotate(-1.5deg); }
.theme-notebook h2 {
  display: inline-block; padding: 0 14px; font-weight: 400;
  background: linear-gradient(transparent 55%, #ffe27a 55%);
}
.theme-notebook strong { color: #c2412d; }
.theme-notebook hr { background: repeating-linear-gradient(90deg, #c9b79a 0 10px, transparent 10px 18px); }
.theme-notebook a { color: #2f6db3; }
.theme-notebook img { border: 6px solid #fff; box-shadow: 0 6px 16px rgba(70, 50, 20, .25); transform: rotate(3deg); border-radius: 12px; }